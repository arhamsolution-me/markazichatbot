# ==============================================================
# Markazi AI Chatbot - Environment Configuration Template
# ==============================================================

# Groq LLM API Keys (Single key or comma-separated list for auto-rotation)
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3

# Primary Model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_OUTPUT_TOKENS=1800

# Optional Bearer Token for Chat API protection
CHAT_API_TOKEN=

# PostgreSQL Database URLs (Markazi QA Multi-Service Architecture)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
MARKAZI_DB_URL=postgresql://dbadmin:dbadmin@127.0.0.1:5432/markazi_qa_is
MARKAZI_IS_DB_URL=postgresql://dbadmin:dbadmin@127.0.0.1:5432/markazi_qa_is
MARKAZI_US_DB_URL=postgresql://dbadmin:dbadmin@127.0.0.1:5432/markazi_qa_us
MARKAZI_LS_DB_URL=postgresql://dbadmin:dbadmin@127.0.0.1:5432/markazi_qa_ls

# Vector DB & Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
