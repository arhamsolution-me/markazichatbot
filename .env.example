# ==============================================================
# Markazi AI Chatbot - Environment Configuration Template
# ==============================================================

# Groq LLM API Keys (Single key or comma-separated list for auto-rotation)
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3

# Primary Model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_OUTPUT_TOKENS=1800

# Server Host and Port
HOST=0.0.0.0
PORT=6070

# Optional Bearer Token for Chat API protection
CHAT_API_TOKEN=

# PostgreSQL Database URLs (Markazi QA Multi-Service Architecture)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
MARKAZI_DB_URL=postgresql://<user>:<password>@<host>:<port>/omni-is-sap-dev
MARKAZI_IS_DB_URL=postgresql://<user>:<password>@<host>:<port>/omni-is-sap-dev
MARKAZI_US_DB_URL=postgresql://<user>:<password>@<host>:<port>/omni-us-dev
MARKAZI_LS_DB_URL=postgresql://<user>:<password>@<host>:<port>/omni-ls-dev

# Vector DB & Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
