# ==============================================================
# Markazi AI Chatbot - Environment Configuration Template
# ==============================================================

# Groq LLM API Keys (Single key or comma-separated list for auto-rotation)
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3

# Primary Model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_INPUT_TOKEN_BUDGET=12000
GROQ_OUTPUT_TOKENS=1800

# Server Host and Port
HOST=0.0.0.0
PORT=6070

# Optional Bearer Token for Chat API protection
CHAT_API_TOKEN=

# ==============================================================
# PostgreSQL Database Configuration (Multi-Service Architecture)
# Discrete credentials adhering to DRY and SonarQube standards
# ==============================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Database Names (3 Multi-Service Databases)
DB_IS_NAME=omni-is-sap-dev
DB_US_NAME=omni-us-dev
DB_LS_NAME=omni-ls-dev

# Vector DB & Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
